# ==============================================================================
# Via Carraria - Local Deployment Environment Template
# Copy this file to .env and set secure random values for your environment.
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=viacarraria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-database-password

# Redis Configuration
REDIS_PASSWORD=replace-with-a-secure-redis-password

# RabbitMQ Message Broker
RABBITMQ_USER=viacarraria
RABBITMQ_PASSWORD=replace-with-a-secure-rabbitmq-password

# MinIO / S3 Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-secure-minio-password
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-with-a-secure-minio-password
S3_BUCKET=viacarraria-sources
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Application & Authentication
NODE_ENV=development
PORT=3000
ADMIN_KEY=replace-with-a-random-32-character-admin-key
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-random-32-character-token
FRONTEND_ORIGIN=http://localhost:4173,http://localhost:5173,http://localhost:4174,http://127.0.0.1:4174

# Weaviate Vector Database
WEAVIATE_HTTP_URL=http://weaviate:8080
WEAVIATE_GRPC_HOST=weaviate
WEAVIATE_GRPC_PORT=50051
WEAVIATE_PQ_ENABLED=false
WEAVIATE_PQ_TRAINING_LIMIT=10000
WEAVIATE_PQ_SEGMENTS=64

# Model Inference Engines
TEI_URL=http://embedding-engine:80
TEI_RERANK_URL=http://reranking-engine:80
TEI_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
TEI_RERANK_MODEL_ID=BAAI/bge-reranker-base
